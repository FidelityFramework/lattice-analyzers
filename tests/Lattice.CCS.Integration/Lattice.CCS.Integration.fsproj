<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <ManagePackageVersionsCentrally>false</ManagePackageVersionsCentrally>
    <OtherFlags></OtherFlags>
    <CCSEditorProject Condition="'$(CCSEditorProject)' == ''">$(MSBuildThisFileDirectory)../../../Composer/src/CCS.Editor/CCS.Editor.fsproj</CCSEditorProject>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Program.fs" />
    <PackageReference Include="FSharp.Core" Version="10.1.401" />
    <ProjectReference Include="$(CCSEditorProject)" />
  </ItemGroup>
</Project>
